# ── AI Provider ──────────────────────────────────────────────────────────────
# Options: openrouter | openai | anthropic | gemini | mock
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys) — supports many models with one key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini direct (used when AI_PROVIDER=gemini — key starts with AIza...)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (Supabase PostgreSQL session pooler) ─────────────────────────────
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_BUCKET=return-manager

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# --- Orchestration -----------------------------------------------------------
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING
LOG_FORMAT=json         # json | text

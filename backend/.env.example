# CUBE Prep Manager — Backend Environment Variables
# Copy to .env and fill in your actual values

# PostgreSQL (pgsql4 / Neon / Supabase / RDS)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cube_prepmanager

# Server
PORT=3001
NODE_ENV=development

# CORS — frontend origin
ALLOWED_ORIGIN=http://localhost:5173

# Vision provider API keys (never in frontend)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
